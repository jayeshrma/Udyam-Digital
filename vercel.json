{
  "functions": {
    "server.py": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.py"
    },
    {
      "source": "/docs",
      "destination": "/server.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/server.py"
    }
  ]
}
